# Staging API — copy to deploy/staging.server.env (local) or platform secret store (Render/Fly/Railway)
# Canonical URLs: deploy/domains.json
# Runbook: docs/staging-deploy.md
# Never commit real secrets.

NODE_ENV=production
PORT=3001

# Database — Supabase: Session pooler for DATABASE_URL (IPv4-safe on Render), Direct for DIRECT_URL
# Direct db.<ref>.supabase.co:5432 is often IPv6-only → Prisma P1001 from Render. See docs/staging-deploy.md §8.1
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require

JWT_SECRET=replace-with-32-char-minimum-random-secret
AUTH_COOKIE_NAME=access_token
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Public URLs — must match DNS + TLS (see deploy/domains.json)
APP_PUBLIC_URL=https://app.staging.theagileforum.com
API_PUBLIC_URL=https://api.staging.theagileforum.com
# Optional override — auto-derived as .staging.theagileforum.com when app/api URLs are set
# AUTH_COOKIE_DOMAIN=.staging.theagileforum.com
CORS_ALLOWED_ORIGINS=https://app.staging.theagileforum.com

# OAuth (live on staging — register redirect URIs in provider consoles)
OAUTH_STUB_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Guest cart + commerce on staging
GUEST_CART_USE_DB=true
INTEGRATION_PROVIDER_MODE=live

# Diagnosis AI — keep stub until OpenRouter key is set; then AI_PROVIDER_MODE=live
AI_PROVIDER_MODE=stub
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Stripe test mode on staging (sk_test_... — same keys as local sandbox)
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Razorpay test mode for INR checkout
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / ops
REQUIRE_EMAIL_VERIFICATION=false
OPS_ENROLLMENT_ALERT_EMAIL=ops@theagileforum.com

# Transactional email — dual provider (Resend fallback + Sender)
# EMAIL_PROVIDER=resend|sender (if unset: Resend if key set, else Sender if token set, else stub)
# Preferred enrollment / transactional From (founder):
EMAIL_FROM=DhirenderVerma@theagileforum.com
EMAIL_FROM_NAME=The Agile Forum
# Resend (fallback / default when RESEND_API_KEY set) — docs/resend-setup.md
RESEND_API_KEY=
# Sender.net (set EMAIL_PROVIDER=sender to activate) — docs/sender-setup.md
# EMAIL_PROVIDER=sender
SENDER_API_TOKEN=
# Optional Mock Interview prep-material URLs (see docs/resend-setup.md)
# MOCK_INTERVIEW_RESOURCES_FOLDER_URL=
# MOCK_INTERVIEW_RESOURCE_SCRUM_TOPICS_URL=
# MOCK_INTERVIEW_RESOURCE_INTERVIEW_QUESTIONS_URL=
# MOCK_INTERVIEW_RESOURCE_SM_SITUATIONAL_URL=
# MOCK_INTERVIEW_RESOURCE_AGILE_SCRUM_QA_URL=
# MOCK_INTERVIEW_RESOURCE_SAFE_QA_DOC_URL=
# Optional: password reset link TTL in hours (default 1)
# PASSWORD_RESET_TTL_HOURS=1

# Observability (optional)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OBSERVABILITY_RELEASE=staging

INTEGRATION_TIMEOUT_MS=5000
INTEGRATION_MAX_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
RESUME_UPLOAD_MAX_MB=5
